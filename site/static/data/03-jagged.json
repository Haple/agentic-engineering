:78.983,"dur":19.941,"words":[{"text":"Now","s":79.283,"e":79.523},{"text":"the","s":79.563,"e":79.603},{"text":"other","s":79.683,"e":79.843},{"text":"side.","s":79.923,"e":80.563},{"text":"Karpathy's","s":80.883,"e":81.523},{"text":"own","s":81.603,"e":81.763},{"text":"app","s":81.843,"e":82.083},{"text":"needed","s":82.163,"e":82.403},{"text":"to","s":82.483,"e":82.523},{"text":"connect","s":82.563,"e":82.883},{"text":"Stripe","s":82.963,"e":83.283},{"text":"payments","s":83.363,"e":83.763},{"text":"to","s":83.803,"e":83.843},{"text":"user","s":83.923,"e":84.163},{"text":"accounts.","s":84.243,"e":85.003},{"text":"The","s":85.283,"e":85.363},{"text":"agent","s":85.443,"e":85.763},{"text":"matched","s":85.843,"e":86.083},{"text":"them","s":86.163,"e":86.243},{"text":"by","s":86.323,"e":86.483},{"text":"email","s":86.563,"e":86.803},{"text":"address","s":86.883,"e":87.283},{"text":"instead","s":87.363,"e":87.763},{"text":"of","s":87.803,"e":87.843},{"text":"a","s":87.883,"e":87.923},{"text":"stable","s":88.003,"e":88.323},{"text":"user","s":88.403,"e":88.643},{"text":"ID.","s":88.723,"e":89.283},{"text":"It","s":89.523,"e":89.603},{"text":"looked","s":89.683,"e":89.843},{"text":"fine,","s":90.043,"e":90.483},{"text":"and","s":90.603,"e":90.723},{"text":"it","s":90.803,"e":90.883},{"text":"would","s":90.923,"e":90.963},{"text":"have","s":91.043,"e":91.203},{"text":"quietly","s":91.403,"e":91.683},{"text":"lost","s":91.763,"e":92.003},{"text":"track","s":92.123,"e":92.243},{"text":"of","s":92.283,"e":92.323},{"text":"money.","s":92.403,"e":92.723},{"text":"Brendan","s":93.283,"e":93.603},{"text":"O'Leary","s":93.643,"e":94.083},{"text":"calls","s":94.203,"e":94.323},{"text":"this","s":94.403,"e":94.563},{"text":"code","s":94.723,"e":94.883},{"text":"that","s":95.043,"e":95.123},{"text":"is","s":95.203,"e":95.363},{"text":"technically","s":95.443,"e":95.923},{"text":"correct,","s":96.003,"e":96.563},{"text":"and","s":96.643,"e":96.723},{"text":"contextually","s":97.003,"e":97.523},{"text":"wrong.","s":97.683,"e":98.323}]},{"template":"statement","chapter":"Where they fail","narration":"Why does this happen? Dex Horthy points at the training itself. The reward checks whether the code runs and the tests pass. Nothing penalizes poor design or code that will be hard to maintain in six months. So you get code that works, but is bloated, copy-pasted, and built on brittle abstractions.","params":{"eyebrow":"Why design suffers","text":"The reward checks that tests pass. *Nothing* checks the design.","sub":"Result: code that works, but is bloated, copy-pasted and brittle.","art":"warn","tone":"bad","sync":false},"start":98.924,"dur":20.019,"words":[{"text":"Why","s":99.224,"e":99.464},{"text":"does","s":99.544,"e":99.624},{"text":"this","s":99.704,"e":99.864},{"text":"happen?","s":99.944,"e":100.624},{"text":"Dex","s":100.904,"e":101.144},{"text":"Horthy","s":101.224,"e":101.624},{"text":"points","s":101.784,"e":101.944},{"text":"at","s":101.984,"e":102.024},{"text":"the","s":102.064,"e":102.104},{"text":"training","s":102.184,"e":102.504},{"text":"itself.","s":102.584,"e":103.344},{"text":"The","s":103.624,"e":103.704},{"text":"reward","s":103.944,"e":104.184},{"text":"checks","s":104.264,"e":104.504},{"text":"whether","s":104.584,"e":104.824},{"text":"the","s":104.864,"e":104.904},{"text":"code","s":104.984,"e":105.224},{"text":"runs","s":105.304,"e":105.704},{"text":"and","s":105.744,"e":105.784},{"text":"the","s":105.864,"e":105.944},{"text":"tests","s":106.024,"e":106.424},{"text":"pass.","s":106.664,"e":107.384},{"text":"Nothing","s":107.464,"e":107.784},{"text":"penalizes","s":107.904,"e":108.504},{"text":"poor","s":108.544,"e":108.664},{"text":"design","s":108.744,"e":109.304},{"text":"or","s":109.424,"e":109.544},{"text":"code","s":109.664,"e":109.784},{"text":"that","s":109.864,"e":109.944},{"text":"will","s":110.024,"e":110.104},{"text":"be","s":110.184,"e":110.264},{"text":"hard","s":110.344,"e":110.424},{"text":"to","s":110.
,"e":34.968},{"text":"a","s":35.048,"e":35.088},{"text":"coding","s":35.128,"e":35.448},{"text":"agent.","s":35.528,"e":35.928},{"text":"You","s":36.408,"e":36.568},{"text":"ask","s":36.648,"e":36.808},{"text":"it","s":36.888,"e":36.928},{"text":"to","s":36.968,"e":37.048},{"text":"fix","s":37.128,"e":37.288},{"text":"an","s":37.368,"e":37.448},{"text":"issue","s":37.528,"e":37.848},{"text":"from","s":37.928,"e":38.008},{"text":"your","s":38.088,"e":38.168},{"text":"tracker.","s":38.408,"e":38.888},{"text":"Hidden","s":39.128,"e":39.368},{"text":"in","s":39.448,"e":39.528},{"text":"the","s":39.568,"e":39.608},{"text":"issue","s":39.688,"e":39.928},{"text":"text,","s":40.008,"e":40.568},{"text":"an","s":40.608,"e":40.648},{"text":"attacker","s":40.768,"e":41.128},{"text":"wrote","s":41.208,"e":41.368},{"text":"instructions:","s":41.768,"e":42.648},{"text":"read","s":42.728,"e":42.968},{"text":"the","s":43.008,"e":43.048},{"text":"SSH","s":43.288,"e":43.848},{"text":"key","s":43.928,"e":44.248},{"text":"and","s":44.288,"e":44.328},{"text":"send","s":44.488,"e":44.648},{"text":"it","s":44.728,"e":44.808},{"text":"to","s":44.848,"e":44.888},{"text":"a","s":44.968,"e":45.048},{"text":"server.","s":45.128,"e":46.008},{"text":"Michael","s":46.168,"e":46.328},{"text":"Patterson","s":46.408,"e":46.888},{"text":"from","s":46.968,"e":47.048},{"text":"Coder","s":47.208,"e":47.608},{"text":"warns","s":47.688,"e":48.008},{"text":"that","s":48.088,"e":48.168},{"text":"injections","s":48.248,"e":48.808},{"text":"can","s":48.888,"e":48.968},{"text":"hide","s":49.048,"e":49.208},{"text":"in","s":49.288,"e":49.528},{"text":"anything","s":49.608,"e":50.008},{"text":"an","s":50.048,"e":50.088},{"text":"agent","s":50.168,"e":50.408},{"text":"trusts:","s":50.608,"e":51.368},{"text":"error","s":51.448,"e":51.608},{"text":"messages,","s":51.688,"e":52.408},{"text":"support","s":52.608,"e":52.808},{"text":"tickets,","s":52.888,"e":53.528},{"text":"CI","s":53.608,"e":53.928},{"text":"logs.","s":54.008,"e":54.648}]},{"template":"venn","chapter":"The lethal trifecta","narration":"Willison's lethal trifecta tells you when this becomes dangerous. Access to private data, like your code, files and credentials. Exposure to untrusted content, like web pages and issues. And a way to communicate externally. When an agent has all three, an attacker can trick it into sending your data to them.","params":{"title":"The lethal trifecta","sub":"Simon Willison's rule for when injection becomes theft","sets":[{"label":"Private data","sub":"code, files, credentials","at":"private data"},{"label":"Untrusted content","sub":"web pages, issues, logs","at":"untrusted content"},{"label":"Outbound channel","sub":"any way to send data out","at":"communicate externally"}],"center":{"label":"data theft","at":"all three"}},"start":55.244,"dur":21.378,"words":[{"text":"Willison's","s":55.544,"e":56.104},{"text":"lethal","s":56.184,"e":56.504},{"text":"trifecta","s":56.584,"e":57.304},{"text":"tells","s":57.384,"e":57.624},{"text":"you","s":57.704,"e":57.864},{"text":"when","s":57.984,"e":58.104},{"text":"this","s":58.184,"e":58.264},{"text":"becomes","s":58.344,"e":58.664},{"text":"dangerous.","s":58.744,"e":59.584},{"text":"Access","s":59.864,"e":60.264},{"text":"to","s":60.344,"e":60.424},{"text":"private","s":60.504,"e":60.824},{"text":"data,","s":60.904,"e":61.384},{"text":"like","s":61.464,"e":61.624},{"text":"your","s":61.704,"e":61.784},{"text":"code,","s":61.864,"e":62.424},{"text":"files","s":62.624,"e":62.824},{"text":"and","s":62.904,"e":62.984},{"text":"credentials.","s":63.064,"e":63.944},{"text":"Exposure","s":64.184,"e":64.744},{"text":"to","s":64.824,"e":64.904},{"text":"untrusted","s":64.984,"e":65.544},{"text":"content,","s":65.704,"e":66.344},{"text":"like","s":66.424,"e":66.584},{"text":"web","s":66.664,"e":66.824},{"text":"pages","s":66.904,"e":67.304},{"text":"and","s":67.384,"e":67.464},{"text":"issues.","s":67.544,"e":68.224},{"text":"And","s":68.424,"e":68.74
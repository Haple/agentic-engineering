,"e":95.998},{"text":"sharp","s":96.078,"e":96.318},{"text":"line","s":96.398,"e":96.718},{"text":"between","s":96.878,"e":97.038},{"text":"soft","s":97.198,"e":97.598},{"text":"and","s":97.678,"e":97.758},{"text":"hard","s":97.838,"e":98.078},{"text":"constraints.","s":98.398,"e":98.998},{"text":"Memory","s":99.278,"e":99.598},{"text":"files,","s":99.678,"e":100.318},{"text":"skills,","s":100.598,"e":101.118},{"text":"style","s":101.278,"e":101.438},{"text":"guides","s":101.518,"e":101.918},{"text":"and","s":101.998,"e":102.078},{"text":"review","s":102.238,"e":102.398},{"text":"bots","s":102.478,"e":102.798},{"text":"are","s":102.878,"e":103.038},{"text":"soft.","s":103.118,"e":103.918},{"text":"They","s":103.998,"e":104.078},{"text":"can","s":104.118,"e":104.158},{"text":"be","s":104.238,"e":104.278},{"text":"forgotten.","s":104.318,"e":105.158},{"text":"Types,","s":105.438,"e":106.078},{"text":"lints,","s":106.158,"e":106.798},{"text":"CI","s":106.878,"e":107.118},{"text":"checks","s":107.198,"e":107.598},{"text":"and","s":107.638,"e":107.678},{"text":"enforced","s":107.758,"e":108.238},{"text":"architecture","s":108.318,"e":108.958},{"text":"are","s":109.038,"e":109.278},{"text":"hard.","s":109.478,"e":110.238},{"text":"If","s":110.318,"e":110.398},{"text":"you","s":110.478,"e":110.558},{"text":"only","s":110.638,"e":110.878},{"text":"have","s":110.958,"e":111.038},{"text":"soft","s":111.198,"e":111.438},{"text":"constraints,","s":111.518,"e":112.238},{"text":"she","s":112.318,"e":112.398},{"text":"warns,","s":112.478,"e":113.198},{"text":"it's","s":113.238,"e":113.438},{"text":"only","s":113.518,"e":113.678},{"text":"a","s":113.758,"e":113.798},{"text":"matter","s":113.838,"e":113.998},{"text":"of","s":114.078,"e":114.158},{"text":"time","s":114.238,"e":114.478},{"text":"before","s":114.558,"e":114.798},{"text":"your","s":114.878,"e":114.958},{"text":"codebase","s":115.038,"e":115.518},{"text":"looks","s":115.638,"e":115.758},{"text":"like","s":115.838,"e":115
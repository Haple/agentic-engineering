":9.68},{"text":"how","s":10,"e":10.08},{"text":"do","s":10.16,"e":10.2},{"text":"you","s":10.24,"e":10.32},{"text":"let","s":10.4,"e":10.48},{"text":"an","s":10.56,"e":10.64},{"text":"agent","s":10.72,"e":11.04},{"text":"work","s":11.16,"e":11.28},{"text":"for","s":11.4,"e":11.52},{"text":"hours","s":11.6,"e":12},{"text":"without","s":12.2,"e":12.4},{"text":"you?","s":12.48,"e":12.88}]},{"template":"timeline","chapter":"Longer runs","narration":"Run lengths have exploded. Boris Cherny recalls that early models could run fifteen or thirty seconds before going off the rails. By 2026, typical unattended runs lasted tens of minutes, some for hours or days. Anthropic's trends report describes a single seven-hour autonomous run that implemented a feature in a twelve-million-line codebase.","params":{"events":[{"when":"2024","label":"15–30 seconds","sub":"before going off the rails","at":"fifteen"},{"when":"2026","label":"10–30 minutes","sub":"typical unattended runs","at":"tens of minutes"},{"when":"2026","label":"7 hours","sub":"one run, 12.5M-line codebase","at":"seven-hour"},{"when":"next","label":"days","sub":"with oversight at key points","now":true,"at":"days"}]},"start":13.742,"dur":24.669,"words":[{"text":"Run","s":14.042,"e":14.362},{"text":"lengths","s":14.442,"e":14.722},{"text":"have","s":14.762,"e":14.842},{"text":"exploded.","s":14.922,"e":16.082},{"text":"Boris","s":16.362,"e":16.682},{"text":"Cherny","s":16.762,"e":17.082},{"text":"recalls","s":17.162,"e":17.562},{"text":"that","s":17.682,"e":17.802},{"text":"early","s":17.962,"e":18.122},{"text":"models","s":18.322,"e":18.522},{"text":"could","s":18.602,"e":18.682},{"text":"run","s":18.842,"e":19.002},{"text":"fifteen","s":19.042,"e":19.482},{"text":"or","s":19.562,"e":19.802},{"text":"thirty","s":19.842,"e":20.042},{"text":"seconds","s":20.282,"e":20.682},{"text":"before","s":20.762,"e":21.002},{"text":"going","s":21.082,"e":21.322},{"text":"off","s":21.402,"e":21.482},{"text":"the","s":21.522,"e":21.56
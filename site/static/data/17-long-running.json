"sh","lines":["while true; do","  cat PROMPT.md | claude -p","done","","# PROMPT.md (core idea)","# Study specs/ and fix_plan.md.","# Pick the ONE most important item. Do only that.","# Run the tests. Commit if green. Update fix_plan.md."],"hl":[{"from":1,"to":3,"at":"bash loop","label":"the whole loop","tone":"agent"},{"from":7,"to":7,"at":"single most important","label":"one task","tone":"good"}]},"start":55.087,"dur":23.467,"words":[{"text":"The","s":55.387,"e":55.467},{"text":"most","s":55.547,"e":55.787},{"text":"famous","s":55.867,"e":56.187},{"text":"version","s":56.267,"e":56.667},{"text":"is","s":56.747,"e":56.907},{"text":"the","s":56.947,"e":56.987},{"text":"Ralph","s":57.067,"e":57.387},{"text":"loop,","s":57.467,"e":57.867},{"text":"by","s":57.947,"e":58.027},{"text":"Geoffrey","s":58.107,"e":58.427},{"text":"Huntley.","s":58.467,"e":58.907},{"text":"In","s":59.467,"e":59.507},{"text":"its","s":59.547,"e":59.707},{"text":"purest","s":59.787,"e":60.187},{"text":"form,","s":60.267,"e":60.827},{"text":"Ralph","s":60.907,"e":61.227},{"text":"is","s":61.307,"e":61.387},{"text":"a","s":61.467,"e":61.507},{"text":"bash","s":61.547,"e":61.867},{"text":"loop.","s":61.947,"e":62.427},{"text":"It","s":62.667,"e":62.827},{"text":"pipes","s":62.987,"e":63.147},{"text":"the","s":63.227,"e":63.307},{"text":"same","s":63.387,"e":63.547},{"text":"prompt","s":63.627,"e":64.027},{"text":"into","s":64.147,"e":64.267},{"text":"a","s":64.347,"e":64.387},{"text":"coding","s":64.427,"e":64.747},{"text":"agent,","s":64.907,"e":65.307},{"text":"again","s":65.547,"e":65.787},{"text":"and","s":65.947,"e":66.027},{"text":"again.","s":66.227,"e":66.507},{"text":"Each","s":67.067,"e":67.227},{"text":"run","s":67.307,"e":67.547},{"text":"starts","s":67.627,"e":67.947},{"text":"with","s":67.987,"e":68.027},{"text":"a","s":68.107,"e":68.187},{"text":"fresh","s":68.307,"e":68.427},{"text":"context,","s":68.507,"e":69.387},{"text":"studies","s":69.467,"e":69.787},{"text":"the","s":69.867,
he intent of both sides, then runs the tests. And cleanup: it remembers the exact command to undo your last commit.","params":{"title":"Git superpowers, on demand","items":[{"text":"Bisect","sub":"“find the commit that broke this”","at":"Bisect"},{"text":"Reflog","sub":"recover work you thought was lost","at":"Reflog"},{"text":"Merge conflicts","sub":"resolved by intent, then tested","at":"Merge conflicts"},{"text":"Cleanup","sub":"undo, split, squash, rewrite messages","at":"cleanup"}]},"start":79.191,"dur":26.263,"words":[{"text":"A","s":79.491,"e":79.651},{"text":"few","s":79.731,"e":79.811},{"text":"git","s":79.891,"e":80.131},{"text":"superpowers","s":80.211,"e":80.931},{"text":"become","s":81.011,"e":81.331},{"text":"everyday","s":81.411,"e":81.891},{"text":"tools.","s":81.971,"e":82.771},{"text":"Bisect:","s":83.091,"e":84.131},{"text":"give","s":84.211,"e":84.291},{"text":"the","s":84.371,"e":84.451},{"text":"agent","s":84.611,"e":84.771},{"text":"a","s":84.811,"e":84.851},{"text":"test","s":84.931,"e":85.171},{"text":"for","s":85.211,"e":85.251},{"text":"a","s":85.331,"e":85.411},{"text":"bug,","s":85.491,"e":85.971},{"text":"and","s":86.011,"e":86.051},{"text":"it","s":86.131,"e":86.291},{"text":"binary-searches","s":86.491,"e":87.091},{"text":"history","s":87.171,"e":87.651},{"text":"to","s":87.731,"e":87.811},{"text":"find","s":87.891,"e":87.971},{"text":"the","s":88.051,"e":88.131},{"text":"commit","s":88.291,"e":88.451},{"text":"that","s":88.531,"e":88.611},{"text":"caused","s":88.691,"e":88.931},{"text":"it.","s":89.011,"e":89.451},{"text":"Reflog:","s":89.731,"e":90.771},{"text":"lost","s":90.851,"e":91.091},{"text":"work","s":91.171,"e":91.411},{"text":"that","s":91.451,"e":91.491},{"text":"was","s":91.571,"e":91.651},{"text":"never","s":91.731,"e":91.891},{"text":"committed?","s":91.971,"e":92.691},{"text":"The","s":92.771,"e":92.851},{"text":"agent","s":92.931,"e":93.171},{"text":"can","s":93.251,"e":93.331},{"text":"often","s":93.411,"e":93.571},